#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/research"

usage() {
    echo "Usage: research PROJECT           open (or reattach to) the session for PROJECT"
    echo "       research DIR/PROJECT       same, but keep PROJECT's directory in DIR"
    echo "       research list              show all research sessions"
    echo "       research remove PROJECT    kill the session (and its directory, if empty)"
}

# Where PROJECT's files live: $ROOT/PROJECT itself, or, for a project created
# elsewhere with "research DIR/PROJECT", the directory that $ROOT/PROJECT
# links to.
location() {
    local dir="$ROOT/$1" target
    if [[ -L "$dir" ]]; then
        target=$(readlink "$dir")
        [[ "$target" == /* ]] || target="$ROOT/$target"
        echo "$target"
    else
        echo "$dir"
    fi
}

# One "NAME<TAB>STATE" line per project, from both the directories under
# $ROOT and the tmux sessions started there. Names that differ only in case
# are the same project and appear once; a live session wins over a bare dir.
# A link whose directory is missing (its drive unmounted, say) still counts.
projects() {
    {
        for d in "$ROOT"/*; do
            [[ -d "$d" || ( -L "$d" && ! -e "$d" ) ]] || continue
            printf '%s\tnone\n' "${d##*/}"
        done
        { tmux list-sessions -F '#{session_name}	#{session_path}	#{?session_attached,attached,detached}' 2>/dev/null || true; } |
            while IFS=$'\t' read -r name path state; do
                if [[ "$path" == "$(location "$name")" ]]; then
                    printf '%s\t%s\n' "$name" "$state"
                fi
            done
    } | awk -F'\t' '
        { k = tolower($1) }
        !(k in state) || state[k] == "none" { name[k] = $1; state[k] = $2 }
        END { for (k in state) printf "%s\t%s\n", name[k], state[k] }
    ' | sort -f
}

# The "NAME<TAB>STATE" line of the existing project matching $1, ignoring case.
find_project() {
    projects | awk -F'\t' -v want="$1" '
        !found && tolower($1) == tolower(want) { print; found = 1 }
    '
}

list() {
    local all dir
    all=$(projects)
    if [[ -z "$all" ]]; then
        echo "No research sessions in $ROOT"
        return
    fi
    printf '%-24s %-9s %s\n' PROJECT SESSION LOCATION
    while IFS=$'\t' read -r name state; do
        dir=$(location "$name")
        [[ -d "$dir" ]] || dir="$dir (missing)"
        [[ "$dir" == "$HOME"/* ]] && dir="~${dir#"$HOME"}"
        printf '%-24s %-9s %s\n' "$name" "$state" "$dir"
    done <<< "$all"
}

remove() {
    local match name state dir
    match=$(find_project "$1")
    if [[ -z "$match" ]]; then
        echo "No such project: $1" >&2
        exit 1
    fi
    IFS=$'\t' read -r name state <<< "$match"
    dir=$(location "$name")

    # Project files are never deleted; only an empty directory goes, along
    # with the link to it if it lives outside $ROOT. A link to a missing
    # directory stays, as its drive may just be unmounted.
    if [[ -d "$dir" ]]; then
        if rmdir "$dir" 2>/dev/null; then
            echo "Removed empty directory $dir"
            if [[ -L "$ROOT/$name" ]]; then
                rm "$ROOT/$name"
            fi
        else
            echo "Kept $dir (not empty)"
        fi
    elif [[ -L "$ROOT/$name" ]]; then
        echo "Kept $ROOT/$name ($dir not found)"
    fi

    # Last, since this may be the session we are running in.
    if [[ "$state" != none ]]; then
        echo "Removed session $name"
        tmux kill-session -t "=$name"
    fi
}

case "${1:-}" in
    list) list; exit ;;
    remove)
        [[ -n "${2:-}" ]] || { usage >&2; exit 1; }
        remove "$2"
        exit
        ;;
    -h|--help) usage; exit ;;
    "") usage >&2; exit 1 ;;
esac

# An argument with a slash is a path: the project is named after its last
# part and lives there, in a directory that DIR must already contain.
NAME=$1
TARGET=
if [[ "$1" == */* ]]; then
    NAME=$(basename "$1")
    parent=$(cd "$(dirname "$1")" 2>/dev/null && pwd -P) || {
        echo "No such directory: $(dirname "$1")" >&2
        exit 1
    }
    # A path into $ROOT itself is just the plain project name.
    [[ "$parent" -ef "$ROOT" ]] || TARGET="$parent/$NAME"
fi

# No dots: tmux turns "." into "_" in session names, and "." / ".." would
# escape $ROOT. No leading dash, so a mistyped flag doesn't become a project.
if [[ ! "$NAME" =~ ^[a-zA-Z0-9_][a-zA-Z0-9_-]*$ ]]; then
    echo "Invalid project name"
    exit 1
fi

# Reuse an existing project whose name differs only in case, so "Foo" and
# "foo" never become two sessions.
PROJECT=$(find_project "$NAME" | cut -f1)
PROJECT="${PROJECT:-$NAME}"
LINK="$ROOT/$PROJECT"

# A project kept outside $ROOT is linked from there, so a plain
# "research PROJECT" finds it again later.
if [[ -n "$TARGET" ]]; then
    if [[ ! -e "$LINK" && ! -L "$LINK" ]]; then
        mkdir -p "$ROOT"
        ln -s "$TARGET" "$LINK"
    elif [[ "$(location "$PROJECT")" != "$TARGET" && ! "$LINK" -ef "$TARGET" ]]; then
        echo "Project $PROJECT already exists at $(location "$PROJECT")" >&2
        exit 1
    fi
elif [[ -L "$LINK" && ! -d "$LINK" ]]; then
    # Don't quietly start over in $ROOT while the real directory is away.
    echo "Project $PROJECT lives at $(location "$PROJECT"), which is missing (is its drive mounted?)" >&2
    exit 1
fi

DIR=$(location "$PROJECT")
mkdir -p "$DIR"

# Inside tmux, switch to the session rather than nesting a new one.
if [[ -n "${TMUX:-}" ]]; then
    tmux has-session -t "=$PROJECT" 2>/dev/null ||
        tmux new-session -d -s "$PROJECT" -c "$DIR"
    exec tmux switch-client -t "=$PROJECT"
fi

exec tmux new-session \
    -A \
    -s "$PROJECT" \
    -c "$DIR"
